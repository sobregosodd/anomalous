{
  "name": "anomalous-action",
  "version": "0.1.0",
  "description": "Collection action for Anomalous — starts and collects a runtime activity dump for a GitHub Actions job.",
  "license": "Apache-2.0",
  "author": "Sebastian Obregoso",
  "contributors": [
    "Lorenzo Susini"
  ],
  "private": true,
  "scripts": {
    "build": "ncc build src/main.ts -o dist/main --minify && ncc build src/post.ts -o dist/post --minify",
    "check": "tsc --noEmit",
    "lint": "eslint src __tests__",
    "format": "prettier --write \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "test": "jest",
    "all": "npm run format && npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@actions/artifact": "^2.2.0",
    "@actions/core": "^2.0.1",
    "@actions/exec": "^2.0.0",
    "@actions/io": "^2.0.0",
    "@actions/tool-cache": "^3.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "ts-jest": "^29.1.5",
    "typescript": "^5.5.3"
  }
}
